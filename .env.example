# Hugging Face API Configuration
VITE_HF_API_KEY=your_huggingface_api_key_here

# MongoDB Configuration (for future backend integration)
VITE_MONGO_URI=your_mongodb_connection_string_here

# Example values:
# VITE_HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/recipeFinder