{
  "name": "ai-powered-recipe-finder",
  "version": "1.0.0",
  "description": "An interactive AI cooking assistant where users can enter ingredients they already have and get AI-generated recipe suggestions. The app integrates Hugging Face models for recipe generation and MongoDB for storing favorites.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "recipe",
    "ai",
    "cooking",
    "food",
    "ingredients",
    "hugging-face",
    "react",
    "typescript",
    "vite",
    "mongodb",
    "recipe-generator",
    "meal-planner",
    "cooking-assistant"
  ],
  "author": {
    "name": "Shashi Verma",
    "email": "meetshashikantkumar@gmail.com",
    "url": "https://github.com/Shashiverm"
  },
  "license": "MIT",
  "homepage": "https://github.com/Shashiverm/ai-powered-recipe-finder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shashiverm/ai-powered-recipe-finder.git"
  },
  "bugs": {
    "url": "https://github.com/Shashiverm/ai-powered-recipe-finder/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.263.1",
    "mongodb": "^6.3.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.0.4",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^23.0.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^1.0.4",
    "@vitest/coverage-v8": "^1.0.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "volta": {
    "node": "18.19.0",
    "npm": "10.2.3"
  }
}